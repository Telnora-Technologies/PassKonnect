PORT=4000

# Postgres connection string (e.g. from a free Neon project — neon.tech).
# Use Neon's POOLED connection string (hostname has "-pooler" in it) — the
# direct/non-pooled endpoint runs out of connections quickly under normal
# request traffic since Prisma opens a connection per request.
DATABASE_URL="postgresql://user:password@host-pooler/dbname?sslmode=require&pgbouncer=true&connection_limit=1"

# Used to sign auth JWTs — set this to a long random string.
JWT_SECRET="change-me-to-a-long-random-string"

# The client app's origin. Used for CORS and to build QR code / public
# profile links embedded in generated certificates.
FRONTEND_URL="http://localhost:5173"

# Seeded admin account (created by `npm run seed`), used to sign in to /admin.
ADMIN_EMAIL="admin@passkonnect.dev"
ADMIN_PASSWORD="ChangeMe123!"
