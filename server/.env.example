PORT=4000

# Postgres connection string (e.g. from a free Neon project — neon.tech).
# Use Neon's POOLED connection string (hostname has "-pooler" in it) — the
# direct/non-pooled endpoint runs out of connections quickly under normal
# request traffic since Prisma opens a connection per request.
DATABASE_URL="postgresql://user:password@host-pooler/dbname?sslmode=require&pgbouncer=true&connection_limit=1"

# Used to sign auth JWTs — set this to a long random string.
JWT_SECRET="change-me-to-a-long-random-string"

# The client app's origin. Used for CORS and to build QR code / public
# profile links embedded in generated certificates.
FRONTEND_URL="http://localhost:5173"

# Seeded admin account (created by `npm run seed`), used to sign in to /admin.
ADMIN_EMAIL="admin@passkonnect.dev"
ADMIN_PASSWORD="ChangeMe123!"

# "development" locally, "production" when deployed (Netlify sets this
# automatically at build time). Affects cookie security flags and log level.
NODE_ENV="development"

# Only needed when deploying to Netlify. File storage (uploaded compliance
# documents, generated certificate PDFs) uses Netlify Blobs in production;
# locally these are unused and storage falls back to server/blob-storage/.
# NETLIFY_SITE_ID: Site settings -> General -> Site details -> Site ID.
# NETLIFY_BLOBS_TOKEN: a Personal Access Token (user avatar -> User settings
# -> Applications -> Personal access tokens -> New access token).
NETLIFY_SITE_ID=""
NETLIFY_BLOBS_TOKEN=""
