// PassKonnect data model — v1
// Postgres-backed (Neon or any standard Postgres instance).

generator client {
  provider      = "prisma-client-js"
  // "native" covers local dev (Windows/Mac/Linux); rhel-openssl-3.0.x covers
  // Netlify Functions, which run on Amazon Linux 2023 (AWS Lambda).
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  isAdmin      Boolean  @default(false)
  createdAt    DateTime @default(now())

  businesses   Business[]
  reviewedDocuments Document[] @relation("DocumentReviewer")
}

model Business {
  id                    String   @id @default(uuid())
  ownerId               String
  owner                 User     @relation(fields: [ownerId], references: [id])
  name                  String
  country               String
  productCategory       String
  productDescription    String
  inputsOrigin          String   // plain-language description of where raw materials/inputs come from
  registrationNumber    String?
  registrationCountry   String?
  contactEmail          String
  contactPhone          String?
  isPublic              Boolean  @default(true)
  verificationStatus    String   @default("unverified") // unverified | pending | verified
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  certificates          Certificate[]
  documents             Document[]

  @@index([ownerId])
}

model Certificate {
  id                String   @id @default(uuid())
  businessId        String
  business          Business @relation(fields: [businessId], references: [id])
  destinationCountry String
  status            String   @default("draft") // draft | issued
  checklist         String   // JSON-encoded export-readiness checklist at time of generation
  pdfPath           String?  // relative path to the generated PDF on disk
  createdAt         DateTime @default(now())

  @@index([businessId])
}

// Snapshot-based audit trail — deliberately NOT a foreign key to Business,
// since these entries are written for businesses that are about to be (or
// have been) deleted. Currently only used to record deletion of a verified
// business, so admins retain a record that verification happened even
// after the owner removes the profile.
model AuditLog {
  id                 String   @id @default(uuid())
  action             String // e.g. "business.deleted"
  businessId         String
  businessName       String
  ownerEmail         String
  verificationStatus String
  performedByEmail   String
  createdAt          DateTime @default(now())

  @@index([businessId])
}

model Document {
  id           String    @id @default(uuid())
  businessId   String
  business     Business  @relation(fields: [businessId], references: [id])
  type         String    // business_registration | tax_id | other
  originalName String
  filePath     String
  status       String    @default("pending") // pending | approved | rejected
  reviewNote   String?
  reviewedById String?
  reviewedBy   User?      @relation("DocumentReviewer", fields: [reviewedById], references: [id])
  reviewedAt   DateTime?
  createdAt    DateTime  @default(now())

  @@index([businessId])
  @@index([status])
}
